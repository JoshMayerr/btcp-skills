{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beacontaylor.com/schemas/plugin-catalog.json",
  "title": "BTCP plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "summary", "kind", "version", "sourcePath", "skills"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["collection", "agent"] },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "sourcePath": { "type": "string", "pattern": "^plugins/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "skills": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
